# sponsormatch — key names only. Alex pastes values into .env (gitignored).
# Read only by server code (src/app/api/*, src/app/page.tsx, src/lib/qloo/mcp.ts).

# Qloo hackathon key from the Google Form on the Qloo Resources page.
# Works only against https://hackathon.api.qloo.com. Leave empty to run in mock mode
# (synthetic fixtures, no network calls to Qloo).
QLOO_API_KEY=

# NVIDIA API key (build.nvidia.com). Nemotron, via
# https://integrate.api.nvidia.com/v1/chat/completions, proposes the optimizer's
# next move and decides when to stop. It never produces scores. Leave empty to
# use the built-in heuristic planner instead.
NVIDIA_API_KEY=

# Optional model override. Default: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=

# Optional, not secrets. The app passes these to the local `qloo mcp` harness.
# Defaults: both base URLs = https://hackathon.api.qloo.com (hackathon keys fail on
# the harness default, api.qloo.com); QLOO_HOME = <tmp>/sponsormatch-qloo-home
# (keeps the harness away from ~/.qloo/config).
QLOO_BASE_URL=
QLOO_TRUSTED_BASE_URL=
QLOO_HOME=
