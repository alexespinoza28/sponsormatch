# sponsormatch — key names only. Alex pastes values into .env (gitignored).
# All three are read only by server code (src/app/api/match/route.ts, src/app/page.tsx).

# Qloo hackathon key from the Google Form on the Qloo Resources page.
# Works only against https://hackathon.api.qloo.com. Leave empty to run in mock mode
# (synthetic fixtures, no network calls to Qloo).
QLOO_API_KEY=

# NVIDIA API key (build.nvidia.com) for Nemotron pitch drafts via
# https://integrate.api.nvidia.com/v1/chat/completions. Leave empty to use
# deterministic template pitches instead.
NVIDIA_API_KEY=

# Optional model override. Default: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=
